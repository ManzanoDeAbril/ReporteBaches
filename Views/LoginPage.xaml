<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ReporteBaches.app.ViewModels"
             x:DataType="viewmodels:LoginViewModel"
             x:Class="ReporteBaches.app.Views.LoginPage"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <viewmodels:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="35" Spacing="20" MaximumWidthRequest="450" HorizontalOptions="Center">

            <Image Source="vialimpia_logo_1781744435595.png" 
                   HeightRequest="110"
                   WidthRequest="110"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Label Text="VíaLimpia"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>

            <Label Text="Sistema de Reportes Viales con Puntos de Recompensa"
                   FontSize="13"
                   TextColor="#94A3B8"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <Border BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="15">

                    <Entry Placeholder="Usuario o Correo"
                           Text="{Binding Email}"
                           TextColor="White"
                           PlaceholderColor="#64748B"
                           Keyboard="Email"
                           HeightRequest="45"/>

                    <Entry Placeholder="Contraseña"
                           Text="{Binding Password}"
                           TextColor="White"
                           PlaceholderColor="#64748B"
                           IsPassword="True"
                           HeightRequest="45"/>

                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#38BDF8" HorizontalOptions="Center"/>

            <Button Text="Entrar"
                    Command="{Binding IniciarSesionCommand}"
                    BackgroundColor="#38BDF8"
                    TextColor="#0F172A"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>