<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ReporteBaches.app.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ReporteBaches.app.Views"
       Shell.FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="#4F46E5" />
                <Setter Property="Shell.ForegroundColor" Value="White" />
                <Setter Property="Shell.TitleColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Pantalla Inicial -->
    <ShellContent Title="Login"
                  Route="Login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Style="{StaticResource BaseStyle}" />

    <!-- Navegación por pestañas -->
    <TabBar Route="MainTabs">

        <Tab Title="Reportar">
            <ShellContent ContentTemplate="{DataTemplate views:ReportarPage}" Style="{StaticResource BaseStyle}"/>
        </Tab>

        <Tab Title="Historial">
            <ShellContent ContentTemplate="{DataTemplate views:HistorialPage}" Style="{StaticResource BaseStyle}"/>
        </Tab>

        <Tab Title="Mi Perfil">
            <ShellContent ContentTemplate="{DataTemplate views:PerfilPage}" Style="{StaticResource BaseStyle}"/>
        </Tab>

    </TabBar>

</Shell>
